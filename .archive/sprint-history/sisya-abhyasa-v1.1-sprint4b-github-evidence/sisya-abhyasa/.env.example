# Never commit real secrets.
SISYA_ENVIRONMENT=development
SISYA_DATABASE_URL=postgresql+psycopg://sisya:sisya@localhost:5432/sisya
SISYA_FRONTEND_ORIGIN=http://localhost:3000
# Optional Sprint 2 AI provider. Leave blank to use the deterministic local Demo 2 recommendation engine.
SISYA_GEMINI_API_KEY=
SISYA_GEMINI_MODEL=gemini-2.5-flash-lite

# GitHub App (Demo 4B)
# Keep all of these server-side. Never prefix them NEXT_PUBLIC_.
SISYA_GITHUB_APP_ID=
SISYA_GITHUB_APP_CLIENT_ID=
SISYA_GITHUB_APP_CLIENT_SECRET=
SISYA_GITHUB_APP_SLUG=
# PEM may be supplied with literal \\n line breaks.
SISYA_GITHUB_APP_PRIVATE_KEY=
SISYA_GITHUB_WEBHOOK_SECRET=
