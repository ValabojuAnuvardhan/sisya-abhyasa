# Śiṣya Abhyāsa - Environment Configuration Example

# Database Settings
# For local dev / testing fallback: sqlite:///./test.db
# For production: postgresql+psycopg://user:password@localhost:5432/sisya
SISYA_DATABASE_URL=sqlite:///./test.db

# Application Environment
SISYA_ENVIRONMENT=development
SISYA_FRONTEND_ORIGIN=http://localhost:5173

# Optional AI Integration (Gemini)
SISYA_GEMINI_API_KEY=
SISYA_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional GitHub Integration
SISYA_GITHUB_APP_ID=
SISYA_GITHUB_APP_CLIENT_ID=
SISYA_GITHUB_APP_CLIENT_SECRET=
SISYA_GITHUB_APP_SLUG=
SISYA_GITHUB_APP_PRIVATE_KEY=
SISYA_GITHUB_WEBHOOK_SECRET=

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
